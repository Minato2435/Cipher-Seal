rules_version = '2';

// Participant-/owner-scoped client access for the `default2` database.
// Every privileged write goes through a Cloud Function (the Admin SDK bypasses
// these rules), so all client writes are closed here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.role == 'admin'; }
    function me()       { return request.auth.uid; }

    // Own profile; admins see everyone. role/status are set by functions only.
    match /users/{uid} {
      allow get: if me() == uid || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Any signed-in user may read a public key (needed to start a session).
    match /publicKeys/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Wrapped private keys: never reachable from a client.
    match /privateKeys/{uid} {
      allow read, write: if false;
    }

    // Sessions you take part in. Client queries must filter
    // where('participants', 'array-contains', uid).
    match /sessions/{sessionId} {
      allow read: if signedIn() && (me() in resource.data.participants || isAdmin());
      allow write: if false;
    }

    // Messages you sent or received. Client queries must filter
    // where('participants', 'array-contains', uid).
    match /messages/{messageId} {
      allow read: if signedIn() && (me() in resource.data.participants || isAdmin());
      allow write: if false;
    }

    // Your own risk score; admins see all (admins may list).
    match /riskScores/{uid} {
      allow get: if me() == uid || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // Monitoring collections: admin read only.
    match /securityEvents/{id} { allow read: if isAdmin(); allow write: if false; }
    match /policyActions/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /alerts/{id}         { allow read: if isAdmin(); allow write: if false; }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
